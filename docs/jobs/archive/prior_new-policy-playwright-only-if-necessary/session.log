{"type":"tool_use","timestamp":1791733797452,"sessionID":"ses_ed458233dffes0Lk4CTNEuavw6","part":{"type":"tool","tool":"read","callID":"call_03_NP3u18Y3JX7g8aSvobbG6228","state":{"status":"completed","input":{"filePath":"/workspace/policies/secrets-hygiene.md"},"output":"<path>/workspace/policies/secrets-hygiene.md</path>\n<type>file</type>\n<content>\n1: # Secrets hygiene\n2: \n3: Never commit, log, print, or hardcode secrets, tokens, keys, or credentials.\n4: Read them from the environment or untracked config, and keep them out of\n5: source, diffs, command output, and error messages.\n\n(End of file - total 5 lines)\n</content>","metadata":{"preview":"# Secrets hygiene\n\nNever commit, log, print, or hardcode secrets, tokens, keys, or credentials.\nRead them from the environment or untracked config, and keep them out of\nsource, diffs, command output, and error messages.","truncated":false,"loaded":[],"display":{"type":"file","path":"/workspace/policies/secrets-hygiene.md","text":"# Secrets hygiene\n\nNever commit, log, print, or hardcode secrets, tokens, keys, or credentials.\nRead them from the environment or untracked config, and keep them out of\nsource, diffs, command output, and error messages.","lineStart":1,"lineEnd":5,"totalLines":5,"truncated":false}},"title":"policies/secrets-hygiene.md","time":{"start":1791733797439,"end":1791733797447}},"id":"prt_12ba811c8001GImTrfTkzzZZ7X","sessionID":"ses_ed458233dffes0Lk4CTNEuavw6","messageID":"msg_12ba8093c0013AhOmvrCRiY5m5"}}
