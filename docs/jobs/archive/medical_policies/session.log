\",\"state\":{\"status\":\"completed\",\"input\":{\"pattern\":\"^branch:\",\"path\":\"/workspace/docs/jobs/medical_policies/brief.md\"},\"output\":\"Found 1 matches\\n/workspace/docs/jobs/medical_policies/brief.md:\\n  Line 5: branch: feature/medical_policies\\n\",\"metadata\":{\"matches\":1,\"truncated\":false},\"title\":\"^branch:\",\"time\":{\"start\":1791634401763,\"end\":1791634401787}},\"id\":\"prt_125bb6985001x7nWkzzj0TkL7m\",\"sessionID\":\"ses_eda44bd40ffe4TvSBP4dtmqSoU\",\"messageID\":\"msg_125bb644f001k4qambzfpez633\"}}\n\n  Line 15: {\"type\":\"tool_use\",\"timestamp\":1791634401963,\"sessionID\":\"ses_eda44bd40ffe4TvSBP4dtmqSoU\",\"part\":{\"type\":\"tool\",\"tool\":\"glob\",\"callID\":\"call_02_oAHb85yXVqBmfSk4kt8P6009\",\"state\":{\"status\":\"completed\",\"input\":{\"pattern\":\"**/policies/**\"},\"output\":\"No files found\",\"metadata\":{\"count\":0,\"truncated\":false},\"title\":\"\",\"time\":{\"start\":1791634401900,\"end\":1791634401933}},\"id\":\"prt_125bb6a47001YbOx3SFX7uqkOX\",\"sessionID\":\"ses_eda44bd40ffe4TvSBP4dtmqSoU\",\"messageID\":\"msg_125bb644f001k4qambzfpez633\"}}\n","metadata":{"matches":33,"truncated":false},"title":"policies|policy","time":{"start":1791634408716,"end":1791634408778}},"id":"prt_125bb84a3001bhjwZ4Ga1GfHYQ","sessionID":"ses_eda44bd40ffe4TvSBP4dtmqSoU","messageID":"msg_125bb7d23001hxVldL2IynUavq"}}
